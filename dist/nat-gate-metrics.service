[Unit]
Description=nat-gate Prometheus metrics exporter
Documentation=https://github.com/h3nr1-d14z/nat-gate
After=network.target nat-gate.service
Wants=nat-gate.service

[Service]
Type=simple
ExecStart=/usr/local/bin/nat-gate metrics --port 9110
Restart=on-failure
RestartSec=5
# Needs NET_ADMIN to read rule counters and the conntrack table
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
